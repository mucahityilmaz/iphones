# Copy to .dev.vars for local `wrangler pages dev`, and set the same two keys in
# production with `wrangler pages secret put <NAME> --project-name=iphoneduo-live`.
# .dev.vars is gitignored. Neither of these belongs in wrangler.toml.

# HMAC key for unsubscribe tokens. Any long random string.
# Generate:  openssl rand -hex 32
UNSUBSCRIBE_SECRET=

# Bearer token for GET /api/export. Any long random string.
# Generate:  openssl rand -hex 32
ADMIN_TOKEN=

# Bindings (DB, RATE_LIMIT) are declared in wrangler.toml, not here.
