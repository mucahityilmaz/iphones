{
  "name": "iphoneduo-live",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler pages dev dist",
    "deploy": "astro build && wrangler pages deploy dist --project-name=iphoneduo-live",
    "db:create": "wrangler d1 create iphoneduo_live",
    "db:migrate:local": "wrangler d1 migrations apply iphoneduo_live --local",
    "db:migrate": "wrangler d1 migrations apply iphoneduo_live --remote",
    "kv:create": "wrangler kv namespace create RATE_LIMIT"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.130.0"
  }
}
