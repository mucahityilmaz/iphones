---
/**
 * Google basic consent mode. Nothing Google-owned is fetched until the visitor
 * accepts — declining leaves gtag.js unloaded entirely, so there are no cookieless
 * pings either. The choice is kept in localStorage so returning visitors are not
 * asked twice.
 */
---

<div
  class="fixed inset-x-0 bottom-0 z-40 flex flex-wrap items-center justify-center gap-x-5 gap-y-3 border-t border-line bg-raise/95 px-5 py-4 backdrop-blur"
  id="consent-banner"
  role="dialog"
  aria-label="Cookie consent"
  hidden
>
  <p class="max-w-[46ch] text-xs leading-relaxed text-muted">
    We use Google Analytics to count visits. It sets cookies, so nothing loads until you
    agree. <a href="/privacy" class="text-ink underline decoration-line">Privacy</a>
  </p>
  <div class="flex gap-2">
    <button
      type="button"
      id="consent-decline"
      class="rounded-full border border-line px-4 py-2 text-xs font-medium text-ink hover:border-muted"
      >Decline</button
    >
    <button
      type="button"
      id="consent-accept"
      class="rounded-full bg-volt px-4 py-2 text-xs font-semibold text-void hover:opacity-90"
      >Accept</button
    >
  </div>
</div>

<button
  type="button"
  id="consent-reset"
  class="fixed bottom-3 right-3 z-40 bg-transparent text-[11px] text-muted hover:text-ink"
  hidden>Cookie settings</button
>

<style>
  /* .fixed sets position, but a utility class also beats the UA [hidden] rule on
     display for flex containers — so state this explicitly or the banner never hides. */
  #consent-banner[hidden],
  #consent-reset[hidden] {
    display: none !important;
  }
</style>

<script is:inline>
  (function () {
    var banner = document.getElementById('consent-banner');
    var reset = document.getElementById('consent-reset');
    if (!banner || !reset) return;

    // The bar is position:fixed and would sit on top of the footer, so the footer is
    // padded by its measured height for as long as it is on screen.
    function syncConsentSpace() {
      var px = banner.hidden ? 0 : banner.offsetHeight;
      document.documentElement.style.setProperty('--consent-space', px + 'px');
    }
    function show() {
      banner.hidden = false;
      reset.hidden = true;
      syncConsentSpace();
    }
    function hide() {
      banner.hidden = true;
      reset.hidden = false;
      syncConsentSpace();
    }

    if (window.__readConsent && window.__readConsent()) hide();
    else show();

    document.getElementById('consent-accept').addEventListener('click', function () {
      window.__writeConsent('granted');
      window.__grantConsent();
      hide();
    });
    document.getElementById('consent-decline').addEventListener('click', function () {
      window.__writeConsent('denied');
      hide();
    });
    reset.addEventListener('click', show);

    if ('ResizeObserver' in window) new ResizeObserver(syncConsentSpace).observe(banner);
    window.addEventListener('resize', syncConsentSpace);
  })();
</script>
